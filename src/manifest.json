{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "chromium:manifest_version": 3,
  "version": "0.1.0",
  "name": "Web UI Commentator",
  "description": "Click any element, comment on it, and export a locator an AI agent can act on.",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "64": "images/icon-64.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_popup": "popup/index.html"
  },
  "commands": {
    "toggle-inspect": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Toggle comment mode"
    }
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "chromium:service_worker": "background.ts"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "./content/scripts.tsx"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
